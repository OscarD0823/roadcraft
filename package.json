{
  "name": "roadcraft-studio",
  "productName": "RoadCraft Studio",
  "version": "0.8.5",
  "description": "Editor visual y seguro para vehículos, tráilers, convoyes logísticos y partidas de RoadCraft.",
  "main": ".vite/build/index.js",
  "author": {
    "name": "OscarD0823"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OscarD0823/roadcraft.git"
  },
  "config": {
    "forge": "./forge.config.mjs"
  },
  "scripts": {
    "start": "electron-forge start",
    "check": "tsc --noEmit && vue-tsc --noEmit",
    "test": "tsx scripts/test-zip-package.ts && tsx scripts/test-save-game.ts && tsx scripts/test-images.ts && esbuild scripts/test-work-equipment.ts --bundle --platform=node --format=cjs --external:electron --outfile=.vite/test-work-equipment.cjs && electron .vite/test-work-equipment.cjs",
    "test:save": "tsx scripts/test-save-game.ts",
    "test:preview": "esbuild scripts/test-preview.ts --bundle --platform=node --format=esm --outfile=.vite/test-preview.mjs && node .vite/test-preview.mjs",
    "test:tpl": "tsx scripts/test-tpl.ts",
    "test:appearance": "tsx scripts/test-appearance.ts",
    "test:logistics": "tsx scripts/test-logistics.ts",
    "test:sand": "esbuild scripts/test-sand-capacity.ts --bundle --platform=node --format=cjs --external:electron --outfile=.vite/test-sand-capacity.cjs && electron .vite/test-sand-capacity.cjs",
    "test:full-package": "tsx scripts/test-full-package.ts",
    "package": "electron-forge package --platform=win32 --arch=x64",
    "make": "cross-env NODE_ENV=production electron-forge make --platform=win32 --arch=x64",
    "build:exe": "npm run make",
    "test:ui": "node scripts/test-view-ui.mjs",
    "test:journey": "cross-env ROADCRAFT_JOURNEY_ONLY=1 node scripts/test-view-ui.mjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "tex-decoder": "^2.0.0",
    "three": "^0.186.1",
    "update-electron-app": "^3.3.0",
    "vue": "^3.5.42",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "sass": "^1.104.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  }
}
